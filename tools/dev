#!/bin/sh
set -eu
root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$root"
case "${1:-}" in
  db-up) cd apps/erp; exec docker compose -p shipyard up -d --wait ;;
  db-stop) cd apps/erp; exec docker compose -p shipyard stop ;;
  db-status) cd apps/erp; exec docker compose -p shipyard ps ;;
  erp) exec apps/erp/shipyard-postgres app.py --port 8001 ;;
  portal) exec python3 -m http.server 8080 --bind 127.0.0.1 --directory apps/portal ;;
  twin-test) exec apps/twin/tools/test.sh "${2:-EditMode}" ;;
  twin-build) exec apps/twin/tools/build.sh ;;
  twin-run) exec apps/twin/Builds/ShipyardTwin.app/Contents/MacOS/ShipyardTwin ;;
  *) printf '%s\n' 'Usage: tools/dev {db-up|db-stop|db-status|erp|portal|twin-test [EditMode|PlayMode]|twin-build|twin-run}' >&2; exit 2 ;;
esac
